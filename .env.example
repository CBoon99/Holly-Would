# Acting Platform V1 — never commit real secrets

APP_ENV=development
APP_URL=http://localhost:3000

# Absolute or relative to web cwd
DATA_DIR=../../.data

# Dev session user (local only)
DEV_USER_ID=dev-user-1
DEV_USER_NAME=Carl

# FFmpeg (defaults to PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

