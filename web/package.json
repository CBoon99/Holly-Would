{
  "name": "@acting-platform/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "start:railway": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test",
    "db:push": "tsx src/scripts/db-push.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:hollywood": "tsx src/scripts/seed-hollywood.ts",
    "db:seed:hollywood:fast": "SEED_LIMIT=40 SKIP_PARTNER_AUDIO=1 HOLLYWOOD_SEED_LIVE_TTS=0 tsx src/scripts/seed-hollywood.ts",
    "db:seed:hollywood:full": "SKIP_PARTNER_AUDIO=1 HOLLYWOOD_SEED_LIVE_TTS=0 tsx src/scripts/seed-hollywood.ts",
    "db:seed:hollywood:voices": "HOLLYWOOD_SEED_LIVE_TTS=1 tsx src/scripts/seed-hollywood.ts",
    "catalogue:stats": "node -e \"const fs=require('fs');const p='content/seed';let n=0;const walk=d=>fs.readdirSync(d).forEach(f=>{const x=d+'/'+f;if(fs.statSync(x).isDirectory())walk(x);else if(f.endsWith('.json')&&f!=='CATALOGUE_INDEX.json'){try{const j=JSON.parse(fs.readFileSync(x,'utf8'));n+=(j.scenes||[]).length;}catch{}}});console.log('scene json entries ≈',n)\"",
    "voices:check": "tsx src/scripts/check-voices.ts",
    "automate": "tsx src/scripts/automate.ts",
    "automate:hollywood": "tsx src/scripts/seed-hollywood.ts && npm run verify",
    "postinstall": "echo 'ready'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@netlify/blobs": "^10.7.11",
    "@netlify/plugin-nextjs": "^5.15.13",
    "nanoid": "^5.1.0",
    "next": "^15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
